# ---------- GLPI ----------
# Raiz de la API REST, SIN barra final. Ej: https://glpi.midominio.com/apirest.php
GLPI_URL=https://glpi.midominio.com/apirest.php
GLPI_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GLPI_USER_TOKEN=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# users_id en GLPI de la cuenta de servicio que usa el puente.
# Los seguimientos escritos por este usuario NUNCA se reenvian a Slack (anti-bucle).
GLPI_BRIDGE_USER_ID=0
# Perfil con el que trabaja la sesion (Administracion > Perfiles, el id de la URL).
# Imprescindible si la cuenta tambien tiene Self-Service: la API entraria con ese
# y no veria ningun ticket. Vacio o 0 = el predeterminado del usuario.
GLPI_PROFILE_ID=

# ---------- Slack ----------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # Socket Mode (App-Level Token, scope connections:write)
SLACK_SIGNING_SECRET=...          # solo necesario si desactivas Socket Mode
# Solo Enterprise Grid: token de organizacion con admin.conversations:write.
# Sin el, CLEANUP_MODE=delete se degrada a purge.
SLACK_ADMIN_TOKEN=

# ---------- Comportamiento ----------
# channel = un canal privado por ticket. UNICO modo en el que la conversacion puede
#           desaparecer del cliente del usuario al cerrar el ticket. <- recomendado
# dm      = mensaje directo con hilo por ticket. Las respuestas del usuario se quedan
#           en su lista de DMs para siempre; no hay forma de quitarlas.
CONVERSATION_MODE=channel
# El canal se llama <prefijo><id>-<titulo>: soporte-6210-el-pc-no-arranca
CHANNEL_PREFIX=soporte-
CHANNEL_INCLUDE_TITLE=true
POLL_INTERVAL_SECONDS=30
# Solape de seguridad al mover el cursor, para no perder eventos por desfase de reloj
POLL_OVERLAP_SECONDS=60
# Si el puente ha estado caido mas de estas horas, no recupera lo acumulado:
# reinicia el cursor a "ahora". 0 = sin limite (procesa todo el atasco).
MAX_CATCHUP_HOURS=0

# Cada cuanto se repasan las conversaciones abiertas para detectar tickets
# borrados en GLPI (su GET devuelve 404 y no vuelven a aparecer en la busqueda).
# 0 = desactivado.
SWEEP_INTERVAL_MINUTES=10

# Si el sondeo deja de progresar durante estos minutos, el proceso se cierra
# solo para que Docker o systemd lo reinicien. 0 = desactivado.
WATCHDOG_MINUTES=5

# Al cerrar/resolver el ticket:
#   archive = solo archivar (el usuario lo sigue encontrando en "canales archivados")
#   purge   = borrar los mensajes del bot + EXPULSAR a los miembros + archivar.
#             Para el usuario el canal y el ticket dejan de existir. <- recomendado
#   delete  = purge + borrado real del canal (solo Enterprise Grid, requiere SLACK_ADMIN_TOKEN)
CLEANUP_MODE=purge

# inline = el usuario responde escribiendo en el canal. Natural, pero sus mensajes
#          son suyos y ningun bot puede borrarlos (purge le retira el acceso).
# modal  = el usuario responde en una ventana emergente. En el canal no queda ni un
#          solo mensaje humano, asi que al cerrar se borra absolutamente todo.
REPLY_MODE=inline
# Minutos de cortesia antes de limpiar (0 = inmediato).
# Ojo: con 0, el mensaje de resolucion tambien se borra al instante. 60 es mas amable.
# Si el usuario escribe en el canal durante el margen de gracia posterior al
# cierre, el ticket se reabre en GLPI y el canal deja de estar condenado.
REOPEN_ON_REPLY=true
# Estado al que vuelve el ticket reabierto (2 = en curso).
REOPEN_STATUS=2
# Avisar por mensaje directo al tecnico asignado cuando se reabre un ticket.
NOTIFY_TECHNICIAN=true
# Canal del equipo de soporte para los avisos sin tecnico asignado (ID C... o
# #nombre). El bot tiene que estar dentro. Vacio = no se usa.
TEAM_CHANNEL=

CLEANUP_DELAY_MINUTES=0
# Si esta puesto, manda sobre los minutos. Util para probar (ej. 30).
CLEANUP_DELAY_SECONDS=

# true  -> solo se abren conversaciones para tickets CREADOS despues de la activacion
# false -> tambien para tickets ya abiertos, pero solo con seguimientos NUEVOS (sin historico)
ONLY_TICKETS_CREATED_AFTER_ACTIVATION=false

# Invitar tambien al tecnico asignado al canal privado
INVITE_TECHNICIAN=false

# Retira de los canales de ticket a quien entre sin haber sido invitado
# por el puente. Evita que un miembro meta a un companero en una conversacion
# que puede llevar datos personales.
ENFORCE_PRIVACY=true
# IDs de Slack (U...) que pueden entrar siempre, separados por comas.
PRIVACY_ALLOWLIST=

# ---------- Pruebas ----------
# Lista blanca de solicitantes. Mientras tenga valores, el puente IGNORA por
# completo cualquier ticket cuyo solicitante no este aqui: no se le escribe a
# nadie mas, pase lo que pase en GLPI. Vacio = todos. Dejalo con tu email
# durante el piloto y vacialo el dia que abras la integracion.
ALLOWED_REQUESTER_EMAILS=

# No escribe nada en Slack ni en GLPI: solo registra en el log lo que haria.
# Usa un DB_PATH distinto para no ensuciar el estado real.
DRY_RUN=false

# Barra de color a la izquierda de cada mensaje segun el tipo
# (verde apertura / azul respuesta / gris cierre). false = mensajes planos.
MESSAGE_COLORS=true

# Al abrir el canal de un ticket que ya existia antes de la integracion, cuantos
# mensajes previos se resumen. 0 = solo la solicitud, el recuento y el enlace.
HISTORY_MESSAGES=3

# Puerto HTTP. Solo se usa si NO hay SLACK_APP_TOKEN (sin Socket Mode).
PORT=3000

DB_PATH=./data/bridge.sqlite
LOG_LEVEL=info
